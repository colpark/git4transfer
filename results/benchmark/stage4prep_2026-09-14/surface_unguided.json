          "title": "Position"
        },
        "wt": {
          "anyOf": [
            {
              "pattern": "^[ACDEFGHIKLMNPQRSTVWY]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wt"
        },
        "mutant": {
