          "default": null,
          "title": "Wt"
        },
        "mutant": {
          "anyOf": [
            {
              "pattern": "^[ACDEFGHIKLMNPQRSTVWY]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mutant"
