  {
    "server": "classical",
    "name": "motif_scan",
    "description": "ANALYSE: one-based overlapping sequence-regex motif hits. A motif is contextual evidence, not a measured variant effect; compare pssm_score and learned esm2_likelihood.",
    "input_schema": {
      "type": "object",
      "properties": {
        "sequence": {
          "title": "Sequence",
          "type": "string"
        },
        "pattern": {
          "title": "Pattern",
