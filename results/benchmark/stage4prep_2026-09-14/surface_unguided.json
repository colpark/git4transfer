[
  {
    "server": "record",
    "name": "submit_answer",
    "description": "SUBMIT: record the one final ranked answer after evaluating and filtering candidates. Receipts must resolve; this records an unscored answer, not a measured assay result.",
    "input_schema": {
      "type": "object",
      "properties": {
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "answer": {
          "additionalProperties": true,
          "title": "Answer",
          "type": "object"
        }
      },
      "required": [
        "item_id",
        "answer"
      ],
      "title": "submit_answerArguments"
    },
    "in_unguided_grant": true
  },
  {
    "server": "record",
    "name": "log_note",
    "description": "RECORD: append an auditable working note or rejection rationale; not final submission. Use submit_answer exactly once when evaluation is finished.",
    "input_schema": {
      "type": "object",
      "properties": {
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "note": {
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "note"
      ],
      "title": "log_noteArguments"
    },
    "in_unguided_grant": true
  },
  {
    "server": "classical",
    "name": "mmseqs_search",
    "description": "RETRIEVE: MMseqs2 homolog IDs and alignment statistics, not sequences. Use blast_msa for query-anchored rows before pssm_score or conservation; compare learned esm2_likelihood separately.",
    "input_schema": {
      "type": "object",
      "properties": {
        "sequence": {
          "title": "Sequence",
          "type": "string"
        },
        "reference_fasta": {
          "title": "Reference Fasta",
          "type": "string"
        },
        "max_hits": {
          "default": 5,
          "title": "Max Hits",
          "type": "integer"
        }
      },
      "required": [
        "sequence",
        "reference_fasta"
      ],
      "title": "mmseqs_searchArguments"
    },
    "in_unguided_grant": true
  },
  {
    "server": "classical",
    "name": "blast_search",
    "description": "RETRIEVE: BLASTP homolog IDs and alignment statistics, not MSA rows. Use blast_msa to retrieve and align sequences for pssm_score or conservation; avoid repeating identical calls.",
    "input_schema": {
      "type": "object",
      "properties": {
        "sequence": {
          "title": "Sequence",
          "type": "string"
        },
        "reference_fasta": {
          "title": "Reference Fasta",
          "type": "string"
        },
        "max_hits": {
          "default": 5,
          "title": "Max Hits",
          "type": "integer"
        }
      },
      "required": [
        "sequence",
        "reference_fasta"
      ],
      "title": "blast_searchArguments"
    },
    "in_unguided_grant": true
  },
  {
    "server": "classical",
    "name": "blast_msa",
    "description": "RETRIEVE\u2192ANALYSE: BLASTP hits plus distinct query-anchored homolog rows, query first. Pass result.msa and result.query to pssm_score or conservation; no fitness label is used.",
    "input_schema": {
      "type": "object",
      "properties": {
        "sequence": {
          "title": "Sequence",
          "type": "string"
        },
        "reference_fasta": {
          "title": "Reference Fasta",
          "type": "string"
        },
        "max_hits": {
          "default": 10,
          "title": "Max Hits",
          "type": "integer"
        }
      },
      "required": [
        "sequence",
        "reference_fasta"
      ],
      "title": "blast_msaArguments"
    },
    "in_unguided_grant": true
  },
  {
    "server": "classical",
    "name": "pssm_score",
    "description": "SCORE, classical evolutionary evidence: substitution log-odds from aligned homologs. Pass variant='G52L' OR one-letter mutant plus position; query and blast_msa rows are required. Compare learned esm2_likelihood.",
    "input_schema": {
      "type": "object",
      "properties": {
        "query": {
          "title": "Query",
          "type": "string"
        },
        "msa": {
          "items": {
            "type": "string"
          },
          "title": "Msa",
          "type": "array"
        },
        "position": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        },
        "mutant": {
          "anyOf": [
            {
              "pattern": "^[ACDEFGHIKLMNPQRSTVWY]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mutant"
        },
        "wt": {
          "anyOf": [
            {
              "pattern": "^[ACDEFGHIKLMNPQRSTVWY]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wt"
        },
        "variant": {
          "anyOf": [
            {
              "pattern": "^[ACDEFGHIKLMNPQRSTVWY][1-9][0-9]*[ACDEFGHIKLMNPQRSTVWY]$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant"
        }
      },
      "required": [
        "query",
        "msa"
      ],
      "title": "pssm_scoreArguments"
    },
    "in_unguided_grant": true
  },
  {
