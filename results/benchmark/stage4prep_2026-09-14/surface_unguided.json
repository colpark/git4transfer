  {
    "server": "classical",
    "name": "hbond_geometry",
    "description": "ANALYSE, geometric evidence: distance/angle hydrogen-bond check on supplied coordinates. Not energy, ddG or variant fitness; compare dssp and learned sequence scores separately.",
    "input_schema": {
      "type": "object",
      "properties": {
        "donor": {
          "items": {
            "type": "number"
          },
          "title": "Donor",
          "type": "array"
        },
        "hydrogen": {
          "items": {
            "type": "number"
          },
          "title": "Hydrogen",
          "type": "array"
        },
        "acceptor": {
          "items": {
            "type": "number"
          },
          "title": "Acceptor",
          "type": "array"
        }
      },
      "required": [
        "donor",
        "hydrogen",
        "acceptor"
      ],
      "title": "hbond_geometryArguments"
    },
    "in_unguided_grant": true
  },
  {
    "server": "analysis",
    "name": "seq_identity",
    "description": "ANALYSE: global BLOSUM62-aligned sequence identity including terminal gaps. Detect redundancy; not fitness or independent validation. For mutation evidence compare pssm_score and esm2_likelihood.",
    "input_schema": {
      "type": "object",
      "properties": {
        "sequence_a": {
          "title": "Sequence A",
