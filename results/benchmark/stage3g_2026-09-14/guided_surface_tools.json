      "type": "object",
      "properties": {
        "query": {
          "title": "Query",
          "type": "string"
        },
        "msa": {
          "items": {
            "type": "string"
          },
          "title": "Msa",
          "type": "array"
        },
        "position": {
          "title": "Position",
          "type": "integer"
        },
        "mutant": {
          "title": "Mutant",
          "type": "string"
        }
      },
      "required": [
        "query",
        "msa",
        "position",
        "mutant"
      ],
      "title": "pssm_scoreArguments"
    }
  },
  {
    "server": "classical",
    "name": "conservation",
