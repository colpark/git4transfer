      "type": "object",
      "properties": {
        "sequence": {
          "title": "Sequence",
          "type": "string"
        },
        "reference_fasta": {
          "title": "Reference Fasta",
          "type": "string"
        },
        "max_hits": {
          "default": 5,
          "title": "Max Hits",
          "type": "integer"
        }
      },
      "required": [
        "sequence",
        "reference_fasta"
      ],
      "title": "mmseqs_searchArguments"
    }
  },
  {
    "server": "classical",
